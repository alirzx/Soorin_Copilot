SOORIN_PRODUCT_READ_TIMEOUT_SECONDS=300
SOORIN_PRODUCT_MAX_RETRIES=5
SOORIN_PRODUCT_RETRY_BACKOFF_SECONDS=3.0
SOORIN_DETECTION_CACHE_ENABLED=true
SOORIN_DETECTION_CACHE_TTL_SECONDS=600
SOORIN_DETECTION_STALE_ON_ERROR=true

# Graph
SOORIN_GRAPH_RAW_PATH=data/raw/topology_raw.json
SOORIN_GRAPH_PICKLE_PATH=data/processed/topology_graph.pkl
SOORIN_GRAPH_STATS_PATH=data/processed/topology_stats.json
SOORIN_GRAPH_GRAPHML_PATH=data/processed/topology_graph.graphml
SOORIN_GRAPH_GEXF_PATH=data/processed/topology_graph.gexf
SOORIN_GRAPH_MAX_UI_NODES=1000
SOORIN_GRAPH_DEFAULT_MIN_DEGREE=1
SOORIN_GRAPH_API_MAX_NEIGHBORS=1000
SOORIN_GRAPH_DEFAULT_SCOPE=node_summary
SOORIN_GRAPH_ONE_HOP_MAX_NODES=500
SOORIN_GRAPH_FULL_NEIGHBORS_HARD_MAX=5000
SOORIN_GRAPH_TWO_HOP_MAX_NODES=1000
SOORIN_GRAPH_MAX_EDGES=5000
SOORIN_GRAPH_MAX_CONTEXT_TOKENS=8000
SOORIN_GRAPH_MAX_PATH_LENGTH=24
SOORIN_GRAPH_FULL_ENUMERATION_MAX_PEERS=100
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_NODES=250
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_EDGES=500
SOORIN_GRAPH_COMPARISON_MAX_PEERS_PER_ENTITY=100
SOORIN_GRAPH_COMPARISON_MAX_SHARED_PEERS=100
SOORIN_GRAPH_AUTO_REFRESH_ENABLED=true
SOORIN_GRAPH_REFRESH_INTERVAL_SECONDS=900
SOORIN_GRAPH_REFRESH_ON_STARTUP=true
SOORIN_GRAPH_REFRESH_STARTUP_DELAY_SECONDS=5
SOORIN_GRAPH_REFRESH_JITTER_SECONDS=30
SOORIN_GRAPH_REFRESH_MAX_CONSECUTIVE_FAILURES=5
SOORIN_GRAPH_REFRESH_KEEP_RAW_SNAPSHOTS=5
SOORIN_GRAPH_REFRESH_KEEP_PROCESSED_SNAPSHOTS=3
SOORIN_GRAPH_REFRESH_LOCK_TIMEOUT_SECONDS=60
SOORIN_GRAPH_REFRESH_MIN_NODES=1
SOORIN_GRAPH_REFRESH_MIN_EDGES=0
SOORIN_GRAPH_REFRESH_MAX_NODE_DROP_RATIO=0.80
SOORIN_GRAPH_REFRESH_MAX_EDGE_DROP_RATIO=0.90

# RAG and embeddings
# Keep the corpus and Hugging Face cache outside this repository.
SOORIN_RAG_ENABLED=false
SOORIN_RAG_SOURCE_ROOT=/path/to/external/soc-knowledge-base
SOORIN_RAG_BACKEND=qdrant
SOORIN_RAG_COLLECTION=soorin_soc_knowledge_bge_base_v1
SOORIN_RAG_TOP_K=5
SOORIN_RAG_SCORE_THRESHOLD=0.65
SOORIN_RAG_QDRANT_MODE=local
SOORIN_RAG_QDRANT_URL=
SOORIN_RAG_QDRANT_PATH=data/qdrant-local
SOORIN_RAG_QDRANT_API_KEY=
SOORIN_RAG_QDRANT_TIMEOUT_SECONDS=10
SOORIN_RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SOORIN_RAG_EMBEDDING_DIMENSION=768
SOORIN_RAG_EMBEDDING_LOCAL_FILES_ONLY=true
SOORIN_RAG_EMBEDDING_CACHE_DIR=
SOORIN_RAG_EMBEDDING_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
SOORIN_RAG_DISTANCE=cosine
SOORIN_RAG_MAX_CONTEXT_TOKENS=3000
SOORIN_RAG_CHUNK_SIZE_CHARS=1200
SOORIN_RAG_CHUNK_OVERLAP_CHARS=150
SOORIN_RAG_UPSERT_BATCH_SIZE=64
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Conversation and context budgeting
SOORIN_CHAT_STORE_HISTORY=true
SOORIN_CHAT_MAX_HISTORY_MESSAGES=20
SOORIN_CONVERSATION_MAX_MESSAGES=12
SOORIN_CONVERSATION_RECENT_RAW_MESSAGES=4
SOORIN_CONVERSATION_SUMMARY_ENABLED=true
SOORIN_CONVERSATION_SUMMARY_TRIGGER_TOKENS=1800
SOORIN_CONVERSATION_SUMMARY_MAX_TOKENS=700
SOORIN_CONVERSATION_SUMMARY_TEMPERATURE=0.0
SOORIN_CONVERSATION_SUMMARY_TIMEOUT_SECONDS=30
SOORIN_SYSTEM_PROMPT_PATH=app/prompts/system_prompt.md

# Development-only observability
SOORIN_HUMAN_TRACE_ENABLED=true
SOORIN_HUMAN_TRACE_DETAIL=detailed
SOORIN_EVIDENCE_SNAPSHOT_ENABLED=false
SOORIN_EVIDENCE_SNAPSHOT_MODE=summary
SOORIN_EVIDENCE_SNAPSHOT_ROOT=data/runtime/evidence
SOORIN_EVIDENCE_SNAPSHOT_TTL_HOURS=48
SOORIN_EVIDENCE_SNAPSHOT_MAX_REQUESTS=100
SOORIN_EVIDENCE_SNAPSHOT_MAX_TOTAL_BYTES=268435456
