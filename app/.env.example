# Runtime and logging
LOG_LEVEL=INFO
SOORIN_LOG_FORMAT=console
SOORIN_LOG_COLOR=auto
SOORIN_LOG_FILE_ENABLED=true
SOORIN_LOG_FILE_PATH=data/runtime/logs/soorin-copilot.log
SOORIN_LOG_FILE_LEVEL=INFO
SOORIN_LOG_FILE_MAX_BYTES=20971520
SOORIN_LOG_FILE_BACKUP_COUNT=10

# API and UI
API_HOST=0.0.0.0
API_PORT=6998
API_RELOAD=false
SOORIN_API_BASE_URL=http://127.0.0.1:6998
SOORIN_API_TIMEOUT_SECONDS=180
STREAMLIT_SERVER_PORT=8503

# LLM deployments
SOORIN_LLM_ENABLED=true
SOORIN_LLM_PROVIDER=arvan
SOORIN_LLM_MAX_TRANSIENT_RETRIES=1
SOORIN_LLM_RETRY_BASE_DELAY_SECONDS=0.25
SOORIN_LLM_RETRY_MAX_DELAY_SECONDS=1.0
SOORIN_LLM_EXPOSE_REASONING=false
SOORIN_LLM_LOG_RAW_RESPONSE=false
SOORIN_LLM_CONTEXT_WINDOW_TOKENS=32768
SOORIN_LLM_RESERVED_OUTPUT_TOKENS=12288
SOORIN_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048
SOORIN_LLM_TOKEN_ESTIMATE_MULTIPLIER=1.35
SOORIN_INTENT_ROUTER_DEPLOYMENT=gpt55
SOORIN_CHAT_DEPLOYMENT=gpt55

# GLM deployment
SOORIN_LLM_GLM_BASE_URL=
SOORIN_LLM_GLM_MODEL=GLM-5.2
SOORIN_LLM_GLM_API_KEY=
SOORIN_LLM_GLM_AUTH_SCHEME=apikey
SOORIN_LLM_GLM_CHAT_PATH=/chat/completions
SOORIN_LLM_GLM_CONNECT_TIMEOUT_SECONDS=8
SOORIN_LLM_GLM_ROUTER_TIMEOUT_SECONDS=15
SOORIN_LLM_GLM_CHAT_TIMEOUT_SECONDS=300
SOORIN_LLM_GLM_MAX_TOKENS=12288
SOORIN_LLM_GLM_ROUTER_MAX_TOKENS=384
SOORIN_LLM_GLM_ROUTER_RETRY_MAX_TOKENS=640
SOORIN_LLM_GLM_CHAT_MAX_TOKENS=4096
SOORIN_LLM_GLM_ROUTER_TEMPERATURE=
SOORIN_LLM_GLM_ROUTER_TOP_P=
SOORIN_LLM_GLM_CHAT_TEMPERATURE=
SOORIN_LLM_GLM_CHAT_TOP_P=
SOORIN_LLM_GLM_SUPPORTS_TEMPERATURE=true
SOORIN_LLM_GLM_SUPPORTS_TOP_P=true

# GPT-5.5 deployment
SOORIN_LLM_GPT55_BASE_URL=
SOORIN_LLM_GPT55_MODEL=GPT-5.5
SOORIN_LLM_GPT55_API_KEY=
SOORIN_LLM_GPT55_AUTH_SCHEME=apikey
SOORIN_LLM_GPT55_CHAT_PATH=/chat/completions
SOORIN_LLM_GPT55_CONNECT_TIMEOUT_SECONDS=8
SOORIN_LLM_GPT55_ROUTER_TIMEOUT_SECONDS=30
SOORIN_LLM_GPT55_CHAT_TIMEOUT_SECONDS=360
SOORIN_LLM_GPT55_MAX_TOKENS=12288
SOORIN_LLM_GPT55_ROUTER_MAX_TOKENS=924
SOORIN_LLM_GPT55_ROUTER_RETRY_MAX_TOKENS=1284
SOORIN_LLM_GPT55_CHAT_MAX_TOKENS=12288
SOORIN_LLM_GPT55_ROUTER_TEMPERATURE=
SOORIN_LLM_GPT55_ROUTER_TOP_P=
SOORIN_LLM_GPT55_CHAT_TEMPERATURE=
SOORIN_LLM_GPT55_CHAT_TOP_P=
SOORIN_LLM_GPT55_SUPPORTS_TEMPERATURE=false
SOORIN_LLM_GPT55_SUPPORTS_TOP_P=false

# Router
SOORIN_INTENT_ROUTER_ENABLED=true
SOORIN_INTENT_ROUTER_SYSTEM_PROMPT_PATH=app/prompts/intent_router_system_prompt.md
SOORIN_INTENT_ROUTER_MIN_CONFIDENCE=0.65
SOORIN_INTENT_ROUTER_RETRY_ENABLED=true

# Planner and agent limits
SOORIN_PLANNER_ENABLED=false
SOORIN_PLANNER_DEPLOYMENT=gpt55
SOORIN_PLANNER_REPAIR_ENABLED=true
SOORIN_AGENT_MAX_SUPPLEMENTAL_RETRIEVALS=1
SOORIN_AGENT_MAX_CAPABILITY_CALLS=6
SOORIN_AGENT_MAX_ENTITIES=2
SOORIN_AGENT_MAX_GRAPH_DEPTH=2
SOORIN_AGENT_EXECUTOR_MAX_CONCURRENCY=4
SOORIN_AGENT_REQUEST_TIMEOUT_SECONDS=120

# Product API
SOORIN_PRODUCT_API_BASE_URL=
SOORIN_PRODUCT_TOPOLOGY_PATH=/zeek/connections/unique-ip-pairs
SOORIN_PRODUCT_ASSET_DETECTION_PATH=/asset-detection/test/{ip}
SOORIN_PRODUCT_ASSET_PROFILE_PATH=/profile/{ip}
SOORIN_PRODUCT_LOGIN_PATH=/auth/login
SOORIN_PRODUCT_API_TOKEN=
SOORIN_PRODUCT_USERNAME=
SOORIN_PRODUCT_PASSWORD=
SOORIN_PRODUCT_CAPTCHA_BYPASS=
