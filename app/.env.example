API_HOST=0.0.0.0
API_PORT=6998
API_RELOAD=true
LOG_LEVEL=INFO
SOORIN_API_BASE_URL=http://127.0.0.1:6998
SOORIN_API_TIMEOUT_SECONDS=120
STREAMLIT_SERVER_PORT=8503

SOORIN_LLM_ENABLED=true
SOORIN_LLM_PROVIDER=arvan

SOORIN_ARVAN_BASE_URL=
SOORIN_ARVAN_MODEL=GLM-5.2
SOORIN_ARVAN_API_KEY=
SOORIN_ARVAN_AUTH_SCHEME=apikey
SOORIN_ARVAN_CHAT_PATH=/chat/completions
SOORIN_ARVAN_TIMEOUT_SECONDS=300
SOORIN_ARVAN_CONNECT_TIMEOUT_SECONDS=30
SOORIN_ARVAN_MAX_TOKENS=8192
SOORIN_ARVAN_TEMPERATURE=0.2
SOORIN_ARVAN_TOP_P=0.9

SOORIN_LLM_EXPOSE_REASONING=false
SOORIN_LLM_LOG_RAW_RESPONSE=false

SOORIN_CHAT_STORE_HISTORY=true
SOORIN_CHAT_MAX_HISTORY_MESSAGES=20
SOORIN_SYSTEM_PROMPT_PATH=app/prompts/system_prompt.md

SOORIN_PRODUCT_API_BASE_URL=
SOORIN_PRODUCT_TOPOLOGY_PATH=/zeek/connections/unique-ip-pairs
SOORIN_PRODUCT_API_TOKEN=
SOORIN_PRODUCT_HWID=
SOORIN_PRODUCT_CONNECT_TIMEOUT_SECONDS=60
SOORIN_PRODUCT_READ_TIMEOUT_SECONDS=300
SOORIN_PRODUCT_MAX_RETRIES=5
SOORIN_PRODUCT_RETRY_BACKOFF_SECONDS=3.0

SOORIN_GRAPH_RAW_PATH=data/raw/topology_raw.json
SOORIN_GRAPH_PICKLE_PATH=data/processed/topology_graph.pkl
SOORIN_GRAPH_STATS_PATH=data/processed/topology_stats.json
SOORIN_GRAPH_GRAPHML_PATH=data/processed/topology_graph.graphml
SOORIN_GRAPH_GEXF_PATH=data/processed/topology_graph.gexf
