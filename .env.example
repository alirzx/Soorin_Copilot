SOORIN_LLM_GLM_SUPPORTS_TOP_P=true

# GPT-5.5 deployment
SOORIN_LLM_GPT55_BASE_URL=https://arvancloudai.ir/gateway/models/GPT-5.5/eU9gedxydZeBM7iPzCoSow7M2hJlQ3hLyyP6FROU7MfQavOMXrdYX8m-U9rfK8DDiV3XoFYKPtECACOJb9hMtNP1UMAYOBu7S8pCC67YVY42Kyeyk1DlKYxH9Qhd-9tUj5P84RSxgk8UHHq1uJDJKGNr1sWhHTb0z3K45vo4XVkQezD6lDqDUYPySIOCfzx5WWeJ5-rTsOHDB4tCejkwTOyjfLmka3KEyHTdbCBcetFrTN7e/v1
SOORIN_LLM_GPT55_MODEL=GPT-5.5
SOORIN_LLM_GPT55_API_KEY=CHANGE_ME
SOORIN_LLM_GPT55_AUTH_SCHEME=apikey
SOORIN_LLM_GPT55_CHAT_PATH=/chat/completions
SOORIN_LLM_GPT55_CONNECT_TIMEOUT_SECONDS=15
SOORIN_LLM_GPT55_ROUTER_TIMEOUT_SECONDS=30
SOORIN_LLM_GPT55_CHAT_TIMEOUT_SECONDS=360
SOORIN_LLM_GPT55_MAX_TOKENS=12288
SOORIN_LLM_GPT55_ROUTER_MAX_TOKENS=1536
SOORIN_LLM_GPT55_ROUTER_RETRY_MAX_TOKENS=3072
SOORIN_LLM_GPT55_CHAT_MAX_TOKENS=12288
SOORIN_LLM_GPT55_ROUTER_TEMPERATURE=
SOORIN_LLM_GPT55_ROUTER_TOP_P=0.0
SOORIN_LLM_GPT55_CHAT_TEMPERATURE=0.1
SOORIN_LLM_GPT55_CHAT_TOP_P=0.9
SOORIN_LLM_GPT55_SUPPORTS_TEMPERATURE=false
SOORIN_LLM_GPT55_SUPPORTS_TOP_P=false

# Router
SOORIN_INTENT_ROUTER_ENABLED=true
SOORIN_INTENT_ROUTER_SYSTEM_PROMPT_PATH=app/prompts/intent_router_system_prompt.md
SOORIN_INTENT_ROUTER_MIN_CONFIDENCE=0.65
SOORIN_INTENT_ROUTER_RETRY_ENABLED=true

# Planner and agent limits
SOORIN_PLANNER_ENABLED=true
SOORIN_PLANNER_DEPLOYMENT=glm
SOORIN_PLANNER_REPAIR_ENABLED=true
SOORIN_PLANNER_SYSTEM_PROMPT_PATH=app/prompts/planner_system_prompt.md
SOORIN_AGENT_MAX_SUPPLEMENTAL_RETRIEVALS=1
SOORIN_AGENT_MAX_CAPABILITY_CALLS=6
SOORIN_AGENT_MAX_ENTITIES=2
SOORIN_AGENT_MAX_GRAPH_DEPTH=2
SOORIN_AGENT_EXECUTOR_MAX_CONCURRENCY=4
SOORIN_AGENT_REQUEST_TIMEOUT_SECONDS=90

# Product API
SOORIN_PRODUCT_API_BASE_URL=http://192.168.0.55:3500
SOORIN_PRODUCT_TOPOLOGY_PATH=/zeek/connections/unique-ip-pairs
SOORIN_PRODUCT_ASSET_DETECTION_PATH=/asset-detection/test/{ip}
SOORIN_PRODUCT_ASSET_PROFILE_PATH=/profile/{ip}
SOORIN_PRODUCT_LOGIN_PATH=/auth/login
LLM_USAGE_REPORTING_ENABLED=true
LLM_USAGE_REPORTING_URL=http://192.168.0.55:3500/llm-token-usage
SOORIN_PRODUCT_API_TOKEN=CHANGE_ME
SOORIN_PRODUCT_USERNAME=CHANGE_ME
SOORIN_PRODUCT_PASSWORD=CHANGE_ME
SOORIN_PRODUCT_CAPTCHA_BYPASS=CHANGE_ME
SOORIN_PRODUCT_TOKEN_REFRESH_SECONDS=600
SOORIN_PRODUCT_HWID=CHANGE_ME
SOORIN_PRODUCT_CONNECT_TIMEOUT_SECONDS=60
SOORIN_PRODUCT_READ_TIMEOUT_SECONDS=300
SOORIN_PRODUCT_MAX_RETRIES=5
SOORIN_PRODUCT_RETRY_BACKOFF_SECONDS=3.0
SOORIN_DETECTION_CACHE_ENABLED=true
SOORIN_DETECTION_CACHE_TTL_SECONDS=600
SOORIN_DETECTION_STALE_ON_ERROR=true

# Graph
SOORIN_GRAPH_RAW_PATH=data/raw/topology_raw.json
SOORIN_GRAPH_PICKLE_PATH=data/processed/topology_graph.pkl
SOORIN_GRAPH_STATS_PATH=data/processed/topology_stats.json
SOORIN_GRAPH_GRAPHML_PATH=data/processed/topology_graph.graphml
SOORIN_GRAPH_GEXF_PATH=data/processed/topology_graph.gexf
SOORIN_GRAPH_MAX_UI_NODES=1000
SOORIN_GRAPH_DEFAULT_MIN_DEGREE=1
SOORIN_GRAPH_API_MAX_NEIGHBORS=850
SOORIN_GRAPH_DEFAULT_SCOPE=node_summary
SOORIN_GRAPH_ONE_HOP_MAX_NODES=350
SOORIN_GRAPH_FULL_NEIGHBORS_HARD_MAX=4000
SOORIN_GRAPH_TWO_HOP_MAX_NODES=800
SOORIN_GRAPH_MAX_EDGES=4000
SOORIN_GRAPH_MAX_CONTEXT_TOKENS=7000
SOORIN_GRAPH_MAX_PATH_LENGTH=24
SOORIN_GRAPH_FULL_ENUMERATION_MAX_PEERS=100
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_NODES=500
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_EDGES=750
SOORIN_GRAPH_COMPARISON_MAX_PEERS_PER_ENTITY=90
SOORIN_GRAPH_COMPARISON_MAX_SHARED_PEERS=90
SOORIN_GRAPH_AUTO_REFRESH_ENABLED=true
SOORIN_GRAPH_REFRESH_INTERVAL_SECONDS=900
SOORIN_GRAPH_REFRESH_ON_STARTUP=true
SOORIN_GRAPH_REFRESH_STARTUP_DELAY_SECONDS=5
SOORIN_GRAPH_REFRESH_JITTER_SECONDS=30
SOORIN_GRAPH_REFRESH_MAX_CONSECUTIVE_FAILURES=5
SOORIN_GRAPH_REFRESH_KEEP_RAW_SNAPSHOTS=5
SOORIN_GRAPH_REFRESH_KEEP_PROCESSED_SNAPSHOTS=3
# Graph snapshot retention in hours: 0 disables TTL cleanup
SOORIN_GRAPH_SNAPSHOT_TTL_HOURS=72
# Optional GraphML/GEXF exports: false for production refresh
SOORIN_GRAPH_OPTIONAL_EXPORTS_ENABLED=false
SOORIN_GRAPH_REFRESH_LOCK_TIMEOUT_SECONDS=60
SOORIN_GRAPH_REFRESH_MIN_NODES=1
SOORIN_GRAPH_REFRESH_MIN_EDGES=0
SOORIN_GRAPH_REFRESH_MAX_NODE_DROP_RATIO=0.80
SOORIN_GRAPH_REFRESH_MAX_EDGE_DROP_RATIO=0.90

# RAG and embeddings
# Keep the corpus and Hugging Face cache outside this repository.
SOORIN_RAG_ENABLED=true
# Required only by the separate indexing maintenance flow.
SOORIN_RAG_BACKEND=qdrant
SOORIN_RAG_COLLECTION=soorin_soc_knowledge_bge_base_v1
SOORIN_RAG_TOP_K=5
SOORIN_RAG_SCORE_THRESHOLD=0.65
SOORIN_RAG_QDRANT_MODE=local
SOORIN_RAG_QDRANT_URL=
SOORIN_RAG_QDRANT_API_KEY=CHANGE_ME
SOORIN_RAG_QDRANT_TIMEOUT_SECONDS=10
SOORIN_RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SOORIN_RAG_EMBEDDING_DIMENSION=768
SOORIN_RAG_EMBEDDING_LOCAL_FILES_ONLY=true
SOORIN_RAG_EMBEDDING_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
SOORIN_RAG_DISTANCE=cosine
SOORIN_RAG_MAX_CONTEXT_TOKENS=2000
SOORIN_RAG_CHUNK_SIZE_CHARS=1000
SOORIN_RAG_CHUNK_OVERLAP_CHARS=110
SOORIN_RAG_UPSERT_BATCH_SIZE=64

# Conversation and context budgeting
SOORIN_CHAT_STORE_HISTORY=true
SOORIN_CHAT_MAX_HISTORY_MESSAGES=20
SOORIN_CONVERSATION_MAX_MESSAGES=4
SOORIN_CONVERSATION_RECENT_RAW_MESSAGES=1
SOORIN_CONVERSATION_SUMMARY_ENABLED=true
SOORIN_CONVERSATION_SUMMARY_TRIGGER_TOKENS=500
SOORIN_CONVERSATION_SUMMARY_MAX_TOKENS=300
SOORIN_CONVERSATION_SUMMARY_TEMPERATURE=0.0
SOORIN_CONVERSATION_SUMMARY_TIMEOUT_SECONDS=120
SOORIN_DURABLE_WORKING_MEMORY_ENABLED=true
SOORIN_MEMORY_RELEVANT_TURN_LIMIT=4
SOORIN_MEMORY_RELEVANT_TURN_TOKEN_BUDGET=900
SOORIN_MEMORY_EPISODE_RETENTION_LIMIT=12
SOORIN_MEMORY_EPISODE_CONTEXT_LIMIT=2
SOORIN_MEMORY_EPISODE_CONTEXT_TOKEN_BUDGET=300
SOORIN_MEMORY_CONTEXT_TOKEN_BUDGET=1400
SOORIN_SYSTEM_PROMPT_PATH=app/prompts/system_prompt.md

# Local development persistence (disabled by default)
SOORIN_LOCAL_PRODUCT_SIMULATION_ENABLED=false
SOORIN_STREAMLIT_AUTH_BACKEND=none
SOORIN_LOCAL_TEST_USER_CREATION_ENABLED=false
SOORIN_THREAD_STATE_BACKEND=memory
SOORIN_LOCAL_SQLITE_PATH=data/runtime/copilot-local.sqlite3
# Reserved for a future checkpoint-safe workflow state projection.
SOORIN_LANGGRAPH_CHECKPOINT_BACKEND=none

# Observability
SOORIN_HUMAN_TRACE_ENABLED=false
# Human trace detail: summary, detailed
SOORIN_HUMAN_TRACE_DETAIL=detailed
SOORIN_EVIDENCE_SNAPSHOT_ENABLED=false
# Evidence snapshot mode: summary, metadata, redacted, none
SOORIN_EVIDENCE_SNAPSHOT_MODE=summary   #summary,metadata,redacted,none
SOORIN_EVIDENCE_SNAPSHOT_TTL_HOURS=24
SOORIN_EVIDENCE_SNAPSHOT_MAX_REQUESTS=100
SOORIN_EVIDENCE_SNAPSHOT_MAX_TOTAL_BYTES=268435456
SOORIN_EVIDENCE_SNAPSHOT_MAX_BYTES=5242880
