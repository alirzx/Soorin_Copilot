SOORIN_LLM_GLM_BASE_URL=https://arvancloudai.ir/gateway/models/GLM-5.2/ywr-06YVRv7uNYgTDtcx_D7QrJGMFl_SHb57qgKFWpmS1x05tgpoXLWhVQGtuobyPLiwkMnnShEoUk0K2X6ZlrF-AAypFO--RZdG4IAZFvSw338T7x0E3bdNKqMDUvfe7wU3M0_gNajzrL71mKTDZdR9UO90NzDq4-AlAUDs9mGqb3vj8-ehIV1zWLM4tHJdvRWAEqXsmA1DrxfmRG-h4rhgPahiZ_rd-rV4OMtFRbQC4wC_/v1
