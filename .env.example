# Soorin Copilot portable deployment environment
# Canonical root environment schema for native and Compose execution

# Deployment
SOORIN_IMAGE_TAG=copilot_release_3.2.1
SOORIN_RESTART_POLICY=unless-stopped

SOORIN_API_BIND_IP=0.0.0.0
SOORIN_API_HOST_PORT=6998

SOORIN_UI_BIND_IP=0.0.0.0
SOORIN_UI_HOST_PORT=8503

SOORIN_API_TIMEOUT_SECONDS=600

# Runtime and logging
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: console, json
SOORIN_LOG_FORMAT=console
# Color mode: auto, always, never
SOORIN_LOG_COLOR=always
SOORIN_LOG_FILE_ENABLED=true
# File log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SOORIN_LOG_FILE_LEVEL=INFO
SOORIN_LOG_FILE_PATH=data/runtime/logs/soorin-copilot.log
SOORIN_LOG_FILE_MAX_BYTES=20971520
SOORIN_LOG_FILE_BACKUP_COUNT=10

# Prometheus metrics (the API endpoint keeps Copilot Bearer authentication)
SOORIN_METRICS_ENABLED=true
SOORIN_METRICS_PATH=/metrics

# Optional local observability profile; host bindings stay private by default
SOORIN_OBSERVABILITY_GRAFANA_BIND_IP=127.0.0.1
SOORIN_OBSERVABILITY_GRAFANA_PORT=3000
SOORIN_OBSERVABILITY_PROMETHEUS_BIND_IP=127.0.0.1
SOORIN_OBSERVABILITY_PROMETHEUS_PORT=9090
SOORIN_OBSERVABILITY_LOKI_BIND_IP=127.0.0.1
SOORIN_OBSERVABILITY_LOKI_PORT=3100
SOORIN_OBSERVABILITY_RETENTION=168h
SOORIN_OBSERVABILITY_ENVIRONMENT=development
# Replace for any shared/server deployment.
SOORIN_GRAFANA_ADMIN_USER=admin
SOORIN_GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# API and UI
# Native API process settings
API_HOST=0.0.0.0
API_PORT=6998
API_RELOAD=false
STREAMLIT_SERVER_PORT=8503
SOORIN_API_BASE_URL=http://127.0.0.1:6998
SOORIN_COPILOT_API_KEY=CHANGE_ME


# LLM deployments
SOORIN_LLM_ENABLED=true
SOORIN_LLM_PROVIDER=arvan
SOORIN_LLM_MAX_TRANSIENT_RETRIES=1
SOORIN_LLM_RETRY_BASE_DELAY_SECONDS=0.25
SOORIN_LLM_RETRY_MAX_DELAY_SECONDS=1.0
SOORIN_LLM_EXPOSE_REASONING=false
SOORIN_LLM_LOG_RAW_RESPONSE=false
SOORIN_LLM_CONTEXT_WINDOW_TOKENS=32768
SOORIN_LLM_RESERVED_OUTPUT_TOKENS=12288
SOORIN_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048
SOORIN_LLM_TOKEN_ESTIMATE_MULTIPLIER=1.35
# Shared OpenAI-compatible transport
SOORIN_LLM_AUTH_SCHEME=apikey
SOORIN_LLM_CHAT_PATH=/chat/completions
SOORIN_LLM_CONNECT_TIMEOUT_SECONDS=8

# Role-based deployments. Use CHANGE_ME_MODEL until each real deployment is approved.
SOORIN_ROUTER_BASE_URL=
SOORIN_ROUTER_MODEL=CHANGE_ME_MODEL
SOORIN_ROUTER_API_KEY=
SOORIN_ROUTER_TIMEOUT_SECONDS=30
SOORIN_ROUTER_MAX_TOKENS=924
SOORIN_ROUTER_RETRY_MAX_TOKENS=1284
SOORIN_ROUTER_TEMPERATURE=0.0
SOORIN_ROUTER_TOP_P=0.1
SOORIN_ROUTER_SUPPORTS_TEMPERATURE=false
SOORIN_ROUTER_SUPPORTS_TOP_P=false

SOORIN_PLANNER_BASE_URL=
SOORIN_PLANNER_MODEL=CHANGE_ME_MODEL
SOORIN_PLANNER_API_KEY=
SOORIN_PLANNER_TIMEOUT_SECONDS=120
SOORIN_PLANNER_MAX_TOKENS=2048
SOORIN_PLANNER_RETRY_MAX_TOKENS=3072
SOORIN_PLANNER_TEMPERATURE=0.0
SOORIN_PLANNER_TOP_P=0.1
SOORIN_PLANNER_SUPPORTS_TEMPERATURE=false
SOORIN_PLANNER_SUPPORTS_TOP_P=false

SOORIN_SYNTHESIZER_BASE_URL=
SOORIN_SYNTHESIZER_MODEL=CHANGE_ME_MODEL
SOORIN_SYNTHESIZER_API_KEY=
SOORIN_SYNTHESIZER_TIMEOUT_SECONDS=360
SOORIN_SYNTHESIZER_MAX_TOKENS=12288
SOORIN_SYNTHESIZER_RETRY_MAX_TOKENS=12288
SOORIN_SYNTHESIZER_TEMPERATURE=0.3
SOORIN_SYNTHESIZER_TOP_P=0.9
SOORIN_SYNTHESIZER_SUPPORTS_TEMPERATURE=false
SOORIN_SYNTHESIZER_SUPPORTS_TOP_P=false

# Router
SOORIN_INTENT_ROUTER_ENABLED=true
SOORIN_INTENT_ROUTER_SYSTEM_PROMPT_PATH=app/prompts/intent_router_system_prompt.md
SOORIN_INTENT_ROUTER_MIN_CONFIDENCE=0.65
SOORIN_INTENT_ROUTER_RETRY_ENABLED=true

# Planner and agent limits
SOORIN_PLANNER_ENABLED=true
SOORIN_PLANNER_REPAIR_ENABLED=true
SOORIN_PLANNER_SYSTEM_PROMPT_PATH=app/prompts/planner_system_prompt.md
SOORIN_AGENT_MAX_SUPPLEMENTAL_RETRIEVALS=1
SOORIN_AGENT_MAX_CAPABILITY_CALLS=6
SOORIN_AGENT_MAX_ENTITIES=2
SOORIN_AGENT_MAX_GRAPH_DEPTH=2
SOORIN_AGENT_EXECUTOR_MAX_CONCURRENCY=4
SOORIN_AGENT_REQUEST_TIMEOUT_SECONDS=90

# Product API authentication (shared by Profile, Detection, Graph refresh, and usage reporting)
SOORIN_PRODUCT_API_BASE_URL=http://product.example.invalid
SOORIN_PRODUCT_TOPOLOGY_PATH=/zeek/connections/unique-ip-pairs
# Full Detection is deep/high-cost. Compact views are the normal model-facing defaults.
SOORIN_PRODUCT_ASSET_DETECTION_PATH=/asset-detection/test/{ip}
# Product Detection compact views reuse the same login/token/x-hwid client.
SOORIN_PRODUCT_ASSET_DETECTION_OVERVIEW_PATH=/asset-detection/{ip}/overview
SOORIN_PRODUCT_ASSET_DETECTION_EVIDENCE_PATH=/asset-detection/{ip}/evidence
SOORIN_PRODUCT_ASSET_DETECTION_SIMILARITY_PATH=/asset-detection/{ip}/similarity
SOORIN_PRODUCT_ASSET_DETECTION_CLUSTER_PATH=/asset-detection/{ip}/cluster
# Profile keeps the current full endpoint; deterministic projections bound model context.
SOORIN_PRODUCT_ASSET_PROFILE_PATH=/profile/{ip}
SOORIN_PRODUCT_LOGIN_PATH=/auth/login
LLM_USAGE_REPORTING_ENABLED=true
LLM_USAGE_REPORTING_URL=http://product.example.invalid/llm-token-usage
SOORIN_PRODUCT_API_TOKEN=CHANGE_ME
SOORIN_PRODUCT_USERNAME=CHANGE_ME
SOORIN_PRODUCT_PASSWORD=CHANGE_ME
SOORIN_PRODUCT_CAPTCHA_BYPASS=CHANGE_ME
SOORIN_PRODUCT_TOKEN_REFRESH_SECONDS=600
SOORIN_PRODUCT_HWID=CHANGE_ME
SOORIN_PRODUCT_CONNECT_TIMEOUT_SECONDS=60
SOORIN_PRODUCT_READ_TIMEOUT_SECONDS=300
SOORIN_PRODUCT_MAX_RETRIES=5
SOORIN_PRODUCT_RETRY_BACKOFF_SECONDS=3.0
SOORIN_DETECTION_CACHE_ENABLED=true
SOORIN_DETECTION_CACHE_TTL_SECONDS=600
SOORIN_DETECTION_STALE_ON_ERROR=true

# Graph
SOORIN_GRAPH_RAW_PATH=data/raw/topology_raw.json
SOORIN_GRAPH_PICKLE_PATH=data/processed/topology_graph.pkl
SOORIN_GRAPH_STATS_PATH=data/processed/topology_stats.json
SOORIN_GRAPH_GRAPHML_PATH=data/processed/topology_graph.graphml
SOORIN_GRAPH_GEXF_PATH=data/processed/topology_graph.gexf
SOORIN_GRAPH_MAX_UI_NODES=1000
SOORIN_GRAPH_DEFAULT_MIN_DEGREE=1
SOORIN_GRAPH_API_MAX_NEIGHBORS=850
SOORIN_GRAPH_DEFAULT_SCOPE=node_summary
SOORIN_GRAPH_ONE_HOP_MAX_NODES=350
SOORIN_GRAPH_FULL_NEIGHBORS_HARD_MAX=4000
SOORIN_GRAPH_TWO_HOP_MAX_NODES=800
SOORIN_GRAPH_MAX_EDGES=4000
SOORIN_GRAPH_MAX_CONTEXT_TOKENS=7000
SOORIN_GRAPH_MAX_PATH_LENGTH=24
SOORIN_GRAPH_FULL_ENUMERATION_MAX_PEERS=100
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_NODES=500
SOORIN_GRAPH_CONTEXT_MAX_ENUMERATED_EDGES=750
SOORIN_GRAPH_COMPARISON_MAX_PEERS_PER_ENTITY=90
SOORIN_GRAPH_COMPARISON_MAX_SHARED_PEERS=90
SOORIN_GRAPH_AUTO_REFRESH_ENABLED=true
SOORIN_GRAPH_REFRESH_INTERVAL_SECONDS=900
SOORIN_GRAPH_REFRESH_ON_STARTUP=true
SOORIN_GRAPH_REFRESH_STARTUP_DELAY_SECONDS=5
SOORIN_GRAPH_REFRESH_JITTER_SECONDS=30
SOORIN_GRAPH_REFRESH_MAX_CONSECUTIVE_FAILURES=5
SOORIN_GRAPH_REFRESH_KEEP_RAW_SNAPSHOTS=5
SOORIN_GRAPH_REFRESH_KEEP_PROCESSED_SNAPSHOTS=3
# Graph snapshot retention in hours: 0 disables TTL cleanup
SOORIN_GRAPH_SNAPSHOT_TTL_HOURS=72
# Optional GraphML/GEXF exports: false for production refresh
SOORIN_GRAPH_OPTIONAL_EXPORTS_ENABLED=false
SOORIN_GRAPH_REFRESH_LOCK_TIMEOUT_SECONDS=60
SOORIN_GRAPH_REFRESH_MIN_NODES=1
SOORIN_GRAPH_REFRESH_MIN_EDGES=0
SOORIN_GRAPH_REFRESH_MAX_NODE_DROP_RATIO=0.80
SOORIN_GRAPH_REFRESH_MAX_EDGE_DROP_RATIO=0.90

# RAG and embeddings
# Keep the corpus and Hugging Face cache outside this repository.
SOORIN_RAG_ENABLED=true
# External corpus root used only by the indexing maintenance flow.
SOORIN_RAG_SOURCE_ROOT=
# Required only by the separate indexing maintenance flow.
SOORIN_RAG_BACKEND=qdrant
SOORIN_RAG_COLLECTION=soorin_soc_knowledge_bge_base_v1
SOORIN_RAG_TOP_K=5
SOORIN_RAG_SCORE_THRESHOLD=0.65
SOORIN_RAG_QDRANT_MODE=local
SOORIN_RAG_QDRANT_URL=
SOORIN_RAG_QDRANT_PATH=data/qdrant-local
SOORIN_RAG_QDRANT_API_KEY=CHANGE_ME
SOORIN_RAG_QDRANT_TIMEOUT_SECONDS=10
SOORIN_RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SOORIN_RAG_EMBEDDING_DIMENSION=768
SOORIN_RAG_EMBEDDING_LOCAL_FILES_ONLY=true
SOORIN_RAG_EMBEDDING_CACHE_DIR=
SOORIN_RAG_EMBEDDING_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
SOORIN_RAG_DISTANCE=cosine
SOORIN_RAG_MAX_CONTEXT_TOKENS=2000
SOORIN_RAG_CHUNK_SIZE_CHARS=1000
SOORIN_RAG_CHUNK_OVERLAP_CHARS=110
SOORIN_RAG_UPSERT_BATCH_SIZE=64

# Conversation and context budgeting
# Gate 8 view selection, evidence gaps, deduplication, and safe delta eligibility
# are deterministic policies; they do not add operator knobs or new secrets.
SOORIN_CHAT_STORE_HISTORY=true
SOORIN_CHAT_MAX_HISTORY_MESSAGES=20
SOORIN_CONVERSATION_MAX_MESSAGES=4
SOORIN_CONVERSATION_RECENT_RAW_MESSAGES=1
SOORIN_CONVERSATION_SUMMARY_ENABLED=true
SOORIN_CONVERSATION_SUMMARY_TRIGGER_TOKENS=500
SOORIN_CONVERSATION_SUMMARY_MAX_TOKENS=300
SOORIN_CONVERSATION_SUMMARY_TEMPERATURE=0.0
SOORIN_CONVERSATION_SUMMARY_TIMEOUT_SECONDS=120
SOORIN_DURABLE_WORKING_MEMORY_ENABLED=true
SOORIN_MEMORY_RELEVANT_TURN_LIMIT=4
SOORIN_MEMORY_RELEVANT_TURN_TOKEN_BUDGET=900
SOORIN_MEMORY_EPISODE_RETENTION_LIMIT=12
SOORIN_MEMORY_EPISODE_CONTEXT_LIMIT=2
SOORIN_MEMORY_EPISODE_CONTEXT_TOKEN_BUDGET=300
SOORIN_MEMORY_CONTEXT_TOKEN_BUDGET=1400

# Typed long-term memory (disabled by default; SQLite is local/test only)
# Only authoritative, entity-bound, fresh, complete, contradiction-free memory
# may satisfy a revision-based/historical evidence requirement.
SOORIN_LONG_TERM_MEMORY_ENABLED=false
SOORIN_LONG_TERM_MEMORY_BACKEND=sqlite
SOORIN_MEMORY_VECTOR_INDEX_ENABLED=false
SOORIN_MEMORY_QDRANT_COLLECTION=soorin_copilot_memory_v1
SOORIN_MEMORY_RETRIEVAL_CANDIDATE_K=20
SOORIN_MEMORY_RETRIEVAL_TOP_K=5
SOORIN_MEMORY_MIN_SCORE=0.35
SOORIN_MEMORY_RERANK_ENABLED=false
SOORIN_MEMORY_RERANK_MODEL=
SOORIN_MEMORY_RERANK_TIMEOUT_SECONDS=10
SOORIN_MEMORY_CONTEXT_LONG_TERM_TOKEN_BUDGET=500
SOORIN_SYSTEM_PROMPT_PATH=app/prompts/synthesizer_static_prompt.md

# Local development persistence (disabled by default)
SOORIN_LOCAL_PRODUCT_SIMULATION_ENABLED=false
SOORIN_STREAMLIT_AUTH_BACKEND=none
SOORIN_LOCAL_TEST_USER_CREATION_ENABLED=false
SOORIN_THREAD_STATE_BACKEND=memory
SOORIN_LOCAL_SQLITE_PATH=data/runtime/copilot-local.sqlite3
# Reserved for a future checkpoint-safe workflow state projection.
SOORIN_LANGGRAPH_CHECKPOINT_BACKEND=none

# Observability
SOORIN_HUMAN_TRACE_ENABLED=false
# Human trace detail: summary, detailed
SOORIN_HUMAN_TRACE_DETAIL=detailed
SOORIN_EVIDENCE_SNAPSHOT_ENABLED=false
# Evidence snapshot mode: summary, metadata, redacted, none
SOORIN_EVIDENCE_SNAPSHOT_MODE=summary   #summary,metadata,redacted,none
SOORIN_EVIDENCE_SNAPSHOT_ROOT=data/runtime/evidence
SOORIN_EVIDENCE_SNAPSHOT_TTL_HOURS=24
SOORIN_EVIDENCE_SNAPSHOT_MAX_REQUESTS=100
SOORIN_EVIDENCE_SNAPSHOT_MAX_TOTAL_BYTES=268435456
SOORIN_EVIDENCE_SNAPSHOT_MAX_BYTES=5242880

# Optional Hugging Face runtime controls. Native development may leave offline
# mode disabled; deployment can provide these through its runtime environment.
HF_HUB_DISABLE_TELEMETRY=true
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false
