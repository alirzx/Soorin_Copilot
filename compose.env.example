SOORIN_IMAGE_TAG=dev-REPLACE_WITH_GIT_SHORT_SHA
SOORIN_RESTART_POLICY=unless-stopped

APP_UID=10001
APP_GID=10001

SOORIN_API_BIND_IP=127.0.0.1
SOORIN_API_PORT=6998

SOORIN_UI_BIND_IP=127.0.0.1
SOORIN_UI_PORT=8503

SOORIN_LOG_LEVEL=INFO

# Local development persistence (disabled by default)
SOORIN_LOCAL_PRODUCT_SIMULATION_ENABLED=false
SOORIN_STREAMLIT_AUTH_BACKEND=none
SOORIN_LOCAL_TEST_USER_CREATION_ENABLED=false
SOORIN_THREAD_STATE_BACKEND=memory
SOORIN_LOCAL_SQLITE_PATH=/workspace/data/runtime/copilot-local.sqlite3
SOORIN_LANGGRAPH_CHECKPOINT_BACKEND=none

# API authentication: shared static Bearer API key
# SOORIN_COPILOT_API_KEY=your-api-key-here

# Host-only persistent mount sources. Both paths must already exist.
SOORIN_DATA_HOST_PATH=/absolute/path/to/Copilot/data
SOORIN_HF_CACHE_HOST_PATH=/absolute/path/to/.cache/huggingface
